# Copy thành backend/.env rồi sửa. Biến môi trường thật (systemd, terminal) được ưu tiên hơn file này.

# 1 = giả lập trên máy tính (không cần MQTT, mắt thu, ESP8266). 0 = chạy thật trên Raspberry Pi.
IRHUB_SIMULATE=1
# Tạo dữ liệu mẫu khi CSDL trống (mặc định bật khi giả lập)
# IRHUB_SEED_DEMO=0

IRHUB_HOST=0.0.0.0
IRHUB_PORT=8000
# IRHUB_DB=/home/pi/ir-control/backend/data/irhub.db

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=irhub

# Chân OUT của mắt thu IR (số GPIO kiểu BCM)
IR_GPIO=18

ACK_TIMEOUT_S=3
SLAVE_STALE_S=90
LEARN_CAPTURES=3
LEARN_TIMEOUT_S=15
LEARN_MIN_MATCH=90
